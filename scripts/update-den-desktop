#!/usr/bin/env bash
set -Eeuo pipefail

# Build and install/update a local Den Desktop release from the canonical repo.
# Intended one-user workflow:
#   scripts/update-den-desktop
# Optional path overrides:
#   DEN_DESKTOP_REPO_DIR="$HOME/dev/den-mcp"
#   DEN_DESKTOP_INSTALL_DIR="$HOME/.local/opt/den-desktop"
#   DEN_DESKTOP_BIN_DIR="$HOME/.local/bin"

REPO_URL="${DEN_DESKTOP_REPO_URL:-git@github.com:FuzzySlipper/den-mcp.git}"
REPO_DIR="${DEN_DESKTOP_REPO_DIR:-$HOME/dev/den-mcp}"
INSTALL_DIR="${DEN_DESKTOP_INSTALL_DIR:-$HOME/.local/opt/den-desktop}"
BIN_DIR="${DEN_DESKTOP_BIN_DIR:-$HOME/.local/bin}"
BRANCH="${DEN_DESKTOP_BRANCH:-main}"
CONFIGURATION="${DEN_DESKTOP_DOTNET_CONFIGURATION:-Release}"
RELEASES_DIR="$INSTALL_DIR/releases"
CURRENT_LINK="$INSTALL_DIR/current"
LAUNCHER="$BIN_DIR/den-desktop"
DESKTOP_DIR="src/DenMcp.Desktop"
SIDECAR_PROJECT="src/DenMcp.Desktop.Sidecar/DenMcp.Desktop.Sidecar.csproj"
STATE_DIR="$INSTALL_DIR/state"

log() { printf '[den-desktop-update] %s\n' "$*"; }
fail() { printf '[den-desktop-update] ERROR: %s\n' "$*" >&2; exit 1; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

git_cmd() {
  git -c "safe.directory=$REPO_DIR" -C "$REPO_DIR" "$@"
}

checksum_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    fail "missing sha256sum or shasum"
  fi
}

copy_tree() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --delete "$src"/ "$dst"/
  else
    rm -rf "$dst"
    mkdir -p "$dst"
    cp -a "$src"/. "$dst"/
  fi
}

assert_clean_worktree() {
  local status
  status="$(git_cmd status --porcelain)"
  if [[ -n "$status" ]]; then
    printf '%s\n' "$status" >&2
    fail "local repo has uncommitted or untracked changes; refusing to update"
  fi
}

ensure_clone() {
  if [[ -d "$REPO_DIR/.git" ]]; then
    return
  fi
  if [[ -e "$REPO_DIR" ]]; then
    fail "$REPO_DIR exists but is not a git checkout"
  fi
  mkdir -p "$(dirname "$REPO_DIR")"
  log "cloning $REPO_URL into $REPO_DIR"
  git clone "$REPO_URL" "$REPO_DIR"
}

ensure_dependencies() {
  local package_json="$REPO_DIR/$DESKTOP_DIR/package.json"
  local package_lock="$REPO_DIR/$DESKTOP_DIR/package-lock.json"
  local marker_dir="$STATE_DIR"
  local marker="$marker_dir/npm-input.sha256"
  local current_hash

  [[ -f "$package_json" ]] || fail "missing $package_json"
  [[ -f "$package_lock" ]] || fail "missing $package_lock"

  current_hash="$( { checksum_file "$package_json"; checksum_file "$package_lock"; } | if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'; else shasum -a 256 | awk '{print $1}'; fi )"

  if [[ ! -d "$REPO_DIR/$DESKTOP_DIR/node_modules" || ! -f "$marker" || "$(<"$marker")" != "$current_hash" ]]; then
    log "running npm ci --include=dev in $DESKTOP_DIR"
    (cd "$REPO_DIR/$DESKTOP_DIR" && npm ci --include=dev)
    mkdir -p "$marker_dir"
    printf '%s\n' "$current_hash" > "$marker"
  else
    log "npm dependencies unchanged; reusing existing node_modules"
  fi
}

write_launcher() {
  mkdir -p "$BIN_DIR"
  cat > "$LAUNCHER" <<'LAUNCHER_EOF'
#!/usr/bin/env bash
set -Eeuo pipefail
INSTALL_DIR="${DEN_DESKTOP_INSTALL_DIR:-$HOME/.local/opt/den-desktop}"
CURRENT="$INSTALL_DIR/current"
[[ -L "$CURRENT" || -d "$CURRENT" ]] || { echo "Den Desktop is not installed at $CURRENT" >&2; exit 1; }
COMMIT="$(cat "$CURRENT/COMMIT" 2>/dev/null || basename "$(readlink -f "$CURRENT")")"
SIDECAR="$CURRENT/sidecar/DenMcp.Desktop.Sidecar"
if [[ ! -x "$SIDECAR" ]]; then
  if [[ -f "$CURRENT/sidecar/DenMcp.Desktop.Sidecar.dll" ]]; then
    SIDECAR="$CURRENT/sidecar/DenMcp.Desktop.Sidecar.dll"
  else
    echo "Missing published sidecar under $CURRENT/sidecar" >&2
    exit 1
  fi
fi
ELECTRON="$CURRENT/node_modules/.bin/electron"
if [[ ! -x "$ELECTRON" ]]; then
  ELECTRON="$CURRENT/node_modules/electron/dist/electron"
fi
[[ -x "$ELECTRON" ]] || { echo "Missing Electron runtime under $CURRENT/node_modules" >&2; exit 1; }
echo "Starting Den Desktop release $COMMIT"
export DEN_DESKTOP_RELEASE_ROOT="$CURRENT"
export DEN_DESKTOP_RELEASE_COMMIT="$COMMIT"
export DEN_DESKTOP_SIDECAR_PATH="$SIDECAR"
exec "$ELECTRON" "$CURRENT/electron-dist/main.mjs" "$@"
LAUNCHER_EOF
  chmod 0755 "$LAUNCHER"
}

atomic_symlink() {
  local target="$1"
  local link="$2"
  local tmp_link="$link.tmp.$$"
  ln -sfn "$target" "$tmp_link"
  mv -Tf "$tmp_link" "$link"
}

main() {
  require_cmd git
  require_cmd node
  require_cmd npm
  require_cmd dotnet
  require_cmd awk

  ensure_clone

  log "checking local worktree cleanliness"
  assert_clean_worktree

  log "fetching $BRANCH"
  git_cmd fetch origin "$BRANCH" --tags
  git_cmd checkout "$BRANCH"
  git_cmd pull --ff-only origin "$BRANCH"
  git_cmd submodule update --init --recursive

  assert_clean_worktree

  local commit release_dir staging previous_target sidecar_exe
  commit="$(git_cmd rev-parse HEAD)"
  release_dir="$RELEASES_DIR/$commit"
  staging="$RELEASES_DIR/.staging-$commit-$$"

  if [[ -d "$release_dir" ]]; then
    log "release already exists: $release_dir"
    write_launcher
    atomic_symlink "$release_dir" "$CURRENT_LINK"
    log "current -> $release_dir"
    log "launch with: $LAUNCHER"
    return
  fi

  ensure_dependencies

  log "building renderer"
  (cd "$REPO_DIR/$DESKTOP_DIR" && npm run ui:build)

  log "building Electron main/preload"
  (cd "$REPO_DIR/$DESKTOP_DIR" && npm run electron:build)

  log "publishing sidecar"
  rm -rf "$staging"
  mkdir -p "$staging/sidecar"
  dotnet publish "$REPO_DIR/$SIDECAR_PROJECT" -c "$CONFIGURATION" -o "$staging/sidecar"

  log "copying release assets"
  copy_tree "$REPO_DIR/$DESKTOP_DIR/dist" "$staging/dist"
  copy_tree "$REPO_DIR/$DESKTOP_DIR/electron-dist" "$staging/electron-dist"
  copy_tree "$REPO_DIR/$DESKTOP_DIR/node_modules" "$staging/node_modules"
  cp "$REPO_DIR/$DESKTOP_DIR/package.json" "$staging/package.json"
  cp "$REPO_DIR/$DESKTOP_DIR/package-lock.json" "$staging/package-lock.json"
  copy_tree "$REPO_DIR/testdata/den-desktop-sidecar" "$staging/testdata/den-desktop-sidecar"
  printf '%s\n' "$commit" > "$staging/COMMIT"
  printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$staging/BUILT_AT"

  sidecar_exe="$staging/sidecar/DenMcp.Desktop.Sidecar"
  if [[ -f "$sidecar_exe" ]]; then
    chmod 0755 "$sidecar_exe"
  elif [[ ! -f "$staging/sidecar/DenMcp.Desktop.Sidecar.dll" ]]; then
    fail "dotnet publish did not produce DenMcp.Desktop.Sidecar executable or dll"
  fi

  previous_target=""
  if [[ -L "$CURRENT_LINK" ]]; then
    previous_target="$(readlink -f "$CURRENT_LINK" || true)"
  fi

  mv "$staging" "$release_dir"
  write_launcher
  atomic_symlink "$release_dir" "$CURRENT_LINK"

  log "installed release $commit"
  log "current -> $release_dir"
  if [[ -n "$previous_target" && "$previous_target" != "$release_dir" ]]; then
    log "previous release retained at: $previous_target"
    log "rollback: ln -sfn '$previous_target' '$CURRENT_LINK.tmp' && mv -Tf '$CURRENT_LINK.tmp' '$CURRENT_LINK'"
  fi
  log "launch with: $LAUNCHER"
}

main "$@"
