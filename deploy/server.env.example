# den-mcp runtime
DenMcp__ListenUrl=http://0.0.0.0:5199

# Legacy/local mode keeps the MCP host database-backed. Adapter deployments
# should set this false so Den Core is the sole SQLite owner/writer and den-mcp
# exposes only Core-backed MCP tools.
DenMcp__LocalDatabaseEnabled=true
DenMcp__DatabasePath=/data/services/den-mcp/server/.den-mcp/den.db

# Den Core adapter target used when LocalDatabaseEnabled=false.
DenCore__BaseUrl=http://127.0.0.1:5299
DenCore__TimeoutSeconds=10
DenCore__ServiceToken=

# Optional LLM settings
DenMcp__Llm__Endpoint=
DenMcp__Llm__ApiKey=
DenMcp__Llm__Model=
